set default:
    node 0:
    "Red" [color=red]
    "Blue" [color=blue]
    "Magenta" [color=magenta]
    "Black" [color=black]
    "White" [color=white]
    "Cool, that's all the colors I wanted to test."
    goto node:1 break

    node 1:
    "Wait I forgot one thing."
    "Cyan" [color=cyan]
    goto node:2 break

    node 2:
    "I just wanted to test if the colors reset properly after the dialogue ends."
    goto set:banter

set banter:
    >> random
    node 0:
    "Unless I'm forgetting something?"
    "Nah, it's probably fine"
    goto END

    node 1:
    "Have a nice day!"
    goto END

    node 2:
    "Have an average day!"
    goto END

    node 3:
    "Have a terrible day!"
    "I'm just kidding by the way, this was my real, final test."
    goto random

    node 4:
    "Bye bye!"
    goto END